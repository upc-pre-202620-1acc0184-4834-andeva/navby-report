person "==Viajero\n<size:16>[Person]</size>\n\nUsuario que planifica y compara vuelos optimizados en precio, duracion y escalas." <<Element-RWxlbWVudCxQZXJzb24=>> as Viajero
rectangle "==FlightAPI\n<size:16>[Software System]</size>\n\nProveedor externo de cotizaciones y tarifas de vuelos comerciales en tiempo real." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as FlightAPI
rectangle "==Mercado Pago\n<size:16>[Software System]</size>\n\nPasarela de pagos para adquisicion de paquetes de creditos Navby." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as MercadoPago
rectangle "==Google Identity\n<size:16>[Software System]</size>\n\nServicio OAuth 2.0 para autenticacion federada de cuentas de usuario." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as GoogleIdentity
rectangle "==Resend\n<size:16>[Software System]</size>\n\nServicio de mensajeria transaccional para verificacion de correo y recuperacion." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as Resend
rectangle "==Plataforma Navby\n<size:16>[Software System]</size>\n\nSistema de enrutamiento inteligente de vuelos y optimizacion multicriterio." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as PlataformaNavby

PlataformaNavby --> FlightAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta ofertas comerciales no cacheadas (max 2 pares)\n<size:16>[HTTPS/JSON]</size>"
FlightAPI --> PlataformaNavby <<Relationship-UmVsYXRpb25zaGlw>> : "Retorna ofertas comerciales vigentes\n<size:16>[HTTPS/JSON]</size>"
PlataformaNavby --> MercadoPago <<Relationship-UmVsYXRpb25zaGlw>> : "Procesa recargas de paquetes de creditos\n<size:16>[HTTPS/REST]</size>"
PlataformaNavby --> GoogleIdentity <<Relationship-UmVsYXRpb25zaGlw>> : "Valida tokens de identidad federada\n<size:16>[HTTPS]</size>"
PlataformaNavby --> Resend <<Relationship-UmVsYXRpb25zaGlw>> : "Despacha correos con enlaces y codigos OTP\n<size:16>[HTTPS/REST]</size>"
Viajero --> PlataformaNavby <<Relationship-UmVsYXRpb25zaGlw>> : "Interactua con el buscador, mapa cartografico y podio\n<size:16>[HTTPS]</size>"

