    MaximumWidth: 200;
  }
  // Plataforma Navby
  .Boundary-UGxhdGFmb3JtYSBOYXZieQ== {
    BackgroundColor: #ffffff;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
  }
</style>

rectangle "Plataforma Navby\n<size:16>[Software System]</size>" <<Boundary-UGxhdGFmb3JtYSBOYXZieQ==>> {
  component "==Motor de Cotizaciones y Podio\n<size:16>[Container: Python, NumPy]</size>\n\nFiltra la frontera de Pareto, normaliza criterios y calcula el ranking multicriterio Top 3." <<Element-RWxlbWVudCxDb250YWluZXIsRW5naW5l>> as PlataformaNavby.MotordeCotizacionesyPodio
  database "==Cache Efimera y Sesiones\n<size:16>[Container: Redis 7]</size>\n\nAlmacena temporalmente cotizaciones de vuelos (TTL 30 min) y control de sesiones." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as PlataformaNavby.CacheEfimeraySesiones
  rectangle "==Aplicacion Web Interactiva (SPA)\n<size:16>[Container: React 19, TypeScript, MapLibre GL, deck.gl]</size>\n\nProporciona la interfaz de usuario, buscador de ciudades, mapa plano 2D y panel del podio." <<Element-RWxlbWVudCxDb250YWluZXIsV2ViQnJvd3Nlcg==>> as PlataformaNavby.AplicacionWebInteractivaSPA
  rectangle "==Plataforma Backend API\n<size:16>[Container: Python 3.12+, FastAPI, Uvicorn]</size>\n\nMonolito modular asincrono que orquesta las solicitudes y expone endpoints REST." <<Element-RWxlbWVudCxDb250YWluZXIsQVBJ>> as PlataformaNavby.PlataformaBackendAPI
  component "==Motor de Rutas (RAM)\n<size:16>[Container: Estructuras nativas de Python]</size>\n\nMantiene el grafo en memoria de 3,354 aeropuertos y ejecuta BFS (poda) y A* (T_min)." <<Element-RWxlbWVudCxDb250YWluZXIsRW5naW5l>> as PlataformaNavby.MotordeRutasRAM
}

rectangle "==FlightAPI\n<size:16>[Software System]</size>\n\nProveedor externo de cotizaciones y tarifas de vuelos comerciales en tiempo real." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sRXh0ZXJuYWw=>> as FlightAPI

PlataformaNavby.AplicacionWebInteractivaSPA --> PlataformaNavby.PlataformaBackendAPI <<Relationship-UmVsYXRpb25zaGlw>> : "1: 1. POST /quotes/search (criterios de viaje)\n<size:16>[JSON/HTTPS]</size>"
PlataformaNavby.PlataformaBackendAPI --> PlataformaNavby.MotordeRutasRAM <<Relationship-UmVsYXRpb25zaGlw>> : "2: 2. select_pairs(origen, destino) [BFS + A*]\n<size:16>[Llamada en RAM]</size>"
PlataformaNavby.MotordeRutasRAM --> PlataformaNavby.PlataformaBackendAPI <<Relationship-UmVsYXRpb25zaGlw>> : "3: 3. Pares alcanzables <= 2 escalas + T_min\n<size:16>[Llamada en RAM]</size>"
PlataformaNavby.PlataformaBackendAPI --> PlataformaNavby.CacheEfimeraySesiones <<Relationship-UmVsYXRpb25zaGlw>> : "4: 4. Consulta cache por par\n<size:16>[RESP/TCP]</size>"
PlataformaNavby.PlataformaBackendAPI --> FlightAPI <<Relationship-UmVsYXRpb25zaGlw>> : "5: 5. Consulta ofertas comerciales sin cache (max 2)\n<size:16>[HTTPS/JSON]</size>"
FlightAPI --> PlataformaNavby.PlataformaBackendAPI <<Relationship-UmVsYXRpb25zaGlw>> : "6: 6. Retorna ofertas vigentes\n<size:16>[HTTPS/JSON]</size>"
PlataformaNavby.PlataformaBackendAPI --> PlataformaNavby.MotordeCotizacionesyPodio <<Relationship-UmVsYXRpb25zaGlw>> : "7: 7. Filtrado de Pareto y puntaje multicriterio\n<size:16>[Llamada en RAM]</size>"
PlataformaNavby.MotordeCotizacionesyPodio --> PlataformaNavby.PlataformaBackendAPI <<Relationship-UmVsYXRpb25zaGlw>> : "8: 8. Podio Top 3 de ofertas\n<size:16>[Llamada en RAM]</size>"
PlataformaNavby.PlataformaBackendAPI --> PlataformaNavby.AplicacionWebInteractivaSPA <<Relationship-UmVsYXRpb25zaGlw>> : "9: 9. Responde podio con coordenadas y deep links\n<size:16>[JSON/HTTPS]</size>"

@enduml